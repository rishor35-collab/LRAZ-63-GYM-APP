{
  "name": "Favorite",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "exercise",
        "food"
      ],
      "description": "Whether this favorite is an exercise or a food"
    },
    "ref_id": {
      "type": "string",
      "description": "Exercise slug or food name used as a stable reference"
    },
    "name": {
      "type": "string"
    },
    "subtitle": {
      "type": "string",
      "description": "Muscle group or food category for display"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "type",
    "ref_id",
    "name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}