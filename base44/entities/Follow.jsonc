{
  "name": "Follow",
  "type": "object",
  "properties": {
    "follower_id": {
      "type": "string",
      "description": "User who follows"
    },
    "follower_name": {
      "type": "string"
    },
    "following_id": {
      "type": "string",
      "description": "User being followed"
    },
    "following_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined"
      ],
      "default": "accepted"
    },
    "acted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "follower_id",
    "following_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "data.follower_id": "{{user.id}}"
    },
    "update": {
      "data.following_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "data.follower_id": "{{user.id}}"
        },
        {
          "data.following_id": "{{user.id}}"
        }
      ]
    }
  }
}