{
  "name": "ActivityPost",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner user id"
    },
    "user_name": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "workout",
        "pr",
        "achievement",
        "cardio",
        "milestone",
        "challenge"
      ],
      "default": "workout"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "entity_type": {
      "type": "string"
    },
    "entity_id": {
      "type": "string"
    },
    "snapshot": {
      "type": "object",
      "description": "Denormalized content snapshot so the post stays viewable even if the original record is deleted"
    },
    "likes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of user ids who liked this post",
      "default": []
    },
    "comment_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "user_id",
    "type",
    "title"
  ],
  "rls": {
    "read": {},
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}