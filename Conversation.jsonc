{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "participant_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Exactly two user ids for a 1-to-1 chat"
    },
    "participant_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Display names aligned with participant_ids"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_message_preview": {
      "type": "string"
    }
  },
  "required": [
    "participant_ids"
  ],
  "rls": {
    "read": {
      "data.participant_ids": "{{user.id}}"
    },
    "create": {
      "data.participant_ids": {
        "$in": [
          "{{user.id}}"
        ]
      }
    },
    "update": {
      "data.participant_ids": {
        "$in": [
          "{{user.id}}"
        ]
      }
    },
    "delete": {
      "data.participant_ids": {
        "$in": [
          "{{user.id}}"
        ]
      }
    }
  }
}