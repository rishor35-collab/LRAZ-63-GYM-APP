{
  "name": "Goal",
  "type": "object",
  "properties": {
    "primary_goal": {
      "type": "string",
      "enum": [
        "Fat Loss",
        "Muscle Gain",
        "Body Recomposition",
        "Strength Gain",
        "Athletic Performance",
        "Endurance",
        "General Fitness",
        "Maintenance"
      ],
      "default": "Body Recomposition"
    },
    "secondary_goal": {
      "type": "string"
    },
    "target_weight_kg": {
      "type": "number"
    },
    "target_body_fat_percent": {
      "type": "number"
    },
    "target_date": {
      "type": "string",
      "format": "date"
    },
    "rate_preference": {
      "type": "string",
      "enum": [
        "Conservative",
        "Moderate",
        "Faster"
      ],
      "default": "Moderate"
    },
    "phase": {
      "type": "string",
      "enum": [
        "Foundation",
        "Hypertrophy",
        "Strength",
        "Power",
        "Cutting",
        "Lean Gaining",
        "Recomposition",
        "Maintenance",
        "Deload",
        "Competition Prep",
        "Post-Event Recovery",
        "Transition"
      ],
      "default": "Recomposition"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "paused"
      ],
      "default": "active"
    },
    "starting_weight_kg": {
      "type": "number"
    },
    "starting_body_fat_percent": {
      "type": "number"
    },
    "calorie_target": {
      "type": "number",
      "description": "Current daily calorie target"
    },
    "protein_target_g": {
      "type": "number"
    },
    "carb_target_g": {
      "type": "number"
    },
    "fat_target_g": {
      "type": "number"
    },
    "fiber_target_g": {
      "type": "number"
    },
    "water_target_ml": {
      "type": "number"
    },
    "step_target": {
      "type": "number",
      "default": 8000
    },
    "progress_percent": {
      "type": "number",
      "default": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "primary_goal"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}