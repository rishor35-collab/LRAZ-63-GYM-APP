{
  "name": "ActivityComment",
  "type": "object",
  "properties": {
    "post_id": {
      "type": "string",
      "description": "Reference to the ActivityPost this comment belongs to"
    },
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "content": {
      "type": "string"
    }
  },
  "required": [
    "post_id",
    "user_id",
    "content"
  ],
  "rls": {
    "read": {},
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}